!.cursor

# Zed config - only track the three main JSON files
.config/zed/*
!.config/zed/keymap.json
!.config/zed/settings.json
!.config/zed/tasks.json

__pycache__
.venv/

# Neovim runtime logs
/.nvimlog
/nvim.log

# Private agent skills (work or personal); installed by bin/agent-init, never committed
skills-private/

# Claude Code mods: the engine lays its API types (and a tsconfig) beside each mod it loads
claude/mods/*/.claude-plugin/types/
claude/mods/*/tsconfig.json
