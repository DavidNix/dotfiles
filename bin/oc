#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: oc [--without-sandbox] [--ds] [--builder MODEL] [--] [OPENCODE_ARGS...]

Run OpenCode V2 with filesystem writes sandboxed by default.

Work machines (whoami or $USER contains "ondo") lack the local nixlab models, so
they use openai/gpt-6.1-sol-fast for title, summary, builder, frontend-builder,
explore and general. --builder still overrides the subagent models.

OPTIONS:
    -h, --help       Show this help message
    --without-sandbox  Run OpenCode directly without the macOS sandbox
    --ds             Override the primary agent models (plan, build, prototype)
                     to fireworks-ai/accounts/fireworks/models/deepseek-v4p1-flash
    --builder MODEL  Override the builder subagent models (builder, frontend-builder, explore, general)
                     to MODEL (provider/model[#variant])
    --server URL     Requires --without-sandbox (tools run on the selected server)
    --               Pass all remaining arguments to OpenCode

Sandboxed launches, model overrides, and Herdr panes use a private server.

EXAMPLES:
    oc
    oc run --model openai/gpt-6.1-sol-fast "Explain this repository"
    oc --ds
    oc --builder openai/gpt-6-astra-fast
    oc --without-sandbox --version
    oc -- --help
EOF
}

die() {
    printf 'oc: %s\n' "$*" >&2
    exit 1
}

# Sets opencode_args. V2 rejects --standalone before the subcommand, so it goes
# after the arguments but ahead of any literal --.
standalone_args() {
    opencode_args=("$@")
    case "${1:-}" in
        acp|debug|mcp|pair|plugin|serve|service|uninstall|update|upgrade) return 0 ;;
        auth|session) [[ $# -ge 2 && "$2" != -* ]] || return 0 ;;
    esac
    opencode_args=()
    while [[ $# -gt 0 && "$1" != -- ]]; do
        opencode_args+=("$1")
        shift
    done
    opencode_args+=(--standalone "$@")
}

main() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage
        exit 0
    fi

    if [[ "$(whoami)" == *ondo* || "${USER:-}" == *ondo* ]]; then
        export OC_ORCH=openai/gpt-6.1-sol-fast
        export OC_SMALL=openai/gpt-6.1-sol-fast
    fi

    local without_sandbox=false model_pattern='^[^/#]+/[^#]*[^/#](#[^#]+)?$'
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --without-sandbox)
                without_sandbox=true
                shift
                ;;
            --ds)
                export OC_PRIMARY=fireworks-ai/accounts/fireworks/models/deepseek-v4p1-flash
                shift
                ;;
            --builder)
                [[ $# -ge 2 ]] || die "--builder requires a MODEL argument"
                [[ "$2" =~ $model_pattern ]] || die "--builder MODEL must be provider/model[#variant]: $2"
                shift
                export OC_ORCH="$1"
                shift
                ;;
            --)
                shift
                break
                ;;
            *) break ;;
        esac
    done

    local opencode_bin
    opencode_bin=$(command -v opencode 2>/dev/null || true)
    [[ -n "$opencode_bin" ]] || die "opencode is not on PATH"
    opencode_bin=$(realpath "$opencode_bin")
    local -a opencode_args=()
    if [[ "$without_sandbox" == true ]]; then
        # The shared service ignores this process's model overrides, and its
        # plugins would report to whichever Herdr pane started it.
        if [[ -n "${OC_ORCH:-}${OC_PRIMARY:-}${OC_SMALL:-}" || "${HERDR_ENV:-}" == 1 ]]; then
            standalone_args "$@"
            exec "$opencode_bin" "${opencode_args[@]}"
        fi
        exec "$opencode_bin" "$@"
    fi

    # A service started here would keep this sandbox and config for later clients.
    case "${1:-}" in
        serve|service) die "$1 manages the shared background service; use --without-sandbox" ;;
    esac
    local arg
    for arg in "$@"; do
        case "$arg" in
            --) break ;;
            --server|--server=*) die "--server requires --without-sandbox" ;;
        esac
    done

    local script_dir repo_dir config_file
    script_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
    # shellcheck disable=SC1091
    source "$script_dir/../script/agent-sandbox.sh"
    repo_dir=$(cd "$script_dir/.." && pwd -P)
    config_file="$repo_dir/opencode/oc-sandbox.jsonc"
    [[ -r "$config_file" ]] || die "sandbox config is unavailable: $config_file"

    sandbox_init oc
    local config_dir data_dir state_dir
    config_dir="$XDG_CONFIG_HOME/opencode"
    data_dir="$XDG_DATA_HOME/opencode"
    state_dir="$XDG_STATE_HOME/opencode"
    mkdir -p "$config_dir" "$XDG_CACHE_HOME/opencode" "$data_dir" "$state_dir"
    export OC_SANDBOX_OPENCODE_DATA_DIR="$data_dir"
    export OPENCODE_CONFIG_CONTENT
    OPENCODE_CONFIG_CONTENT=$(<"$config_file")
    sandbox_allow_dir "$config_dir"
    sandbox_allow_dir "$data_dir"
    sandbox_allow_dir "$state_dir"
    sandbox_allow_dir "$HOME/.opencode"
    # MCP OAuth providers cache their tokens here.
    mkdir -p "$HOME/.mcp-auth"
    sandbox_allow_dir "$HOME/.mcp-auth"
    # The shared V2 service would execute tools outside this process's sandbox.
    standalone_args "$@"
    sandbox_run "$opencode_bin" "${opencode_args[@]}"
}

main "$@"
