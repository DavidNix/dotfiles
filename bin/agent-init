#!/usr/bin/env bash
# Install Claude Code, OpenCode, skills, and plugins
# Works on macOS and Linux
# Usage: agent-init [--reset]
# This script is idempotent - safe to run multiple times

set -euo pipefail

# Parse arguments
RESET_MODE=false
if [[ "${1:-}" == "--reset" ]]; then
    RESET_MODE=true
fi

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$SCRIPT_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DOTFILES_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
LOCAL_SKILLS_SOURCE="${DOTFILES_ROOT}/skills"
# Gitignored; holds work or personal skills that must not be published
PRIVATE_SKILLS_SOURCE="${DOTFILES_ROOT}/skills-private"

# Colors (ANSI escape codes - work on both macOS and Linux)
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
GRAY='\033[0;90m'
NC='\033[0m' # No Color

echo "Agent Initialization"
echo "===================="

# Helper: run command, warn on failure while continuing
try_or_warn() {
    local desc="$1"
    shift
    if "$@"; then
        return 0
    else
        local exit_code=$?
        echo -e "${YELLOW}Warning: Failed: ${desc}${NC}"
        echo -e "${YELLOW}  Exit code: ${exit_code}${NC}"
        return 0  # Continue anyway
    fi
}

# Helper: suppress command output unless it fails
try_or_warn_quiet() {
    local desc="$1"
    shift
    local log_file
    log_file="$(mktemp)"
    if "$@" >"$log_file" 2>&1; then
        rm -f "$log_file"
        return 0
    else
        local exit_code=$?
        echo -e "${YELLOW}Warning: Failed: ${desc}${NC}"
        echo -e "${YELLOW}  Exit code: ${exit_code}${NC}"
        while IFS= read -r line; do
            echo -e "${YELLOW}  ${line}${NC}"
        done <"$log_file"
        rm -f "$log_file"
        return 0  # Continue anyway
    fi
}

# Reset skills by removing all globally installed skills
reset_skills() {
    echo ""
    echo "Resetting skills..."
    try_or_warn_quiet "reset skills" npx --yes skills remove -g --all --yes
    echo -e "${GREEN}Skills reset${NC}"
}

# Install Claude Code via official installer (if not already installed)
install_claude() {
    echo ""
    if command -v claude &>/dev/null; then
        echo -e "${GRAY}Claude Code already installed, skipping${NC}"
        return 0
    fi
    echo "Installing Claude Code..."
    curl -fsSL https://claude.ai/install.sh | bash
    echo -e "${GREEN}Claude Code installed${NC}"
}

# The V2 installer replaces curl-installed V1 binaries in ~/.opencode/bin.
install_opencode() {
    echo ""
    local version=""
    if command -v opencode >/dev/null 2>&1; then
        version=$(opencode --version 2>/dev/null || true)
        version=${version##* }
        version=${version#v}
        if [[ "$version" == 2.* ]]; then
            echo -e "${GRAY}OpenCode V2 already installed, skipping${NC}"
            return 0
        fi
        if command -v brew >/dev/null 2>&1 && brew list --versions opencode >/dev/null 2>&1; then
            brew uninstall opencode
        fi
    fi
    echo "Installing OpenCode V2..."
    curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path
    # The upstream installer also adds a retired side-by-side command.
    rm -f "$HOME/.opencode/bin/opencode2"
    export PATH="$HOME/.opencode/bin:$PATH"
    echo -e "${GREEN}OpenCode V2 installed${NC}"
}

# Install a skill via npx skills
install_skill() {
    local repo="$1"
    local skill="$2"
    echo -e "  Installing ${skill}..."
    # To add codex support in the future: -a "codex". codex does not handle skills as well as claude code and
    # I use codex more for code review vs. implementation
    try_or_warn_quiet "install $skill" npx --yes skills add "$repo" --skill "$skill" -g -y -a "claude-code" -a "opencode"
}

# Rename an installed skill: its directory, its frontmatter name, and any
# per-agent symlinks pointing at the old name.
rename_installed_skill() {
    local from="$1"
    local to="$2"
    local skills_dir="$HOME/.agents/skills"
    if [ ! -d "$skills_dir/$from" ]; then
        echo -e "  ${YELLOW}rename skipped: $from not installed${NC}"
        return 0
    fi
    try_or_warn_quiet "rename $from to $to" mv "$skills_dir/$from" "$skills_dir/$to"
    # Agents discover skills by the frontmatter name, so patch it too.
    try_or_warn_quiet "rename $from frontmatter" \
        sed -i '' "s/^name: $from\$/name: $to/" "$skills_dir/$to/SKILL.md"
    # Repoint agent symlinks that reference the old name (relative links into
    # ~/.agents/skills, as created by the skills CLI).
    local link_dir
    for link_dir in "$HOME/.claude/skills" "$HOME/.config/opencode/skills"; do
        if [ -L "$link_dir/$from" ]; then
            rm "$link_dir/$from"
            ln -s "../../.agents/skills/$to" "$link_dir/$to"
        fi
    done
}

# Install skills via npx
install_skills() {
    echo ""
    echo "Installing skills..."

    # Use OpenCode's built-in customize-opencode skill instead of a local equivalent.
    echo -e "  Installing local repo skills from ${LOCAL_SKILLS_SOURCE}..."
    try_or_warn_quiet "Installing local skills" npx --yes skills add "$LOCAL_SKILLS_SOURCE" -g -y -a "claude-code" -a "opencode"

    if compgen -G "${PRIVATE_SKILLS_SOURCE}/*/SKILL.md" >/dev/null; then
        echo -e "  Installing private skills from ${PRIVATE_SKILLS_SOURCE}..."
        try_or_warn_quiet "Installing private skills" npx --yes skills add "$PRIVATE_SKILLS_SOURCE" -g -y -a "claude-code" -a "opencode"
    fi

    echo -e "  Installing nixpowers skills..."
    try_or_warn_quiet "Installing nixpowers skills" npx --yes skills add "https://github.com/DavidNix/nixpowers" -g -y -a "claude-code" -a "opencode"

    echo -e "  Installing emilkowalski skills..."
    try_or_warn_quiet "Installing emilkowalski skills" npx --yes skills add "emilkowalski/skill" -g -y -a "claude-code" -a "opencode"
    # Emil's repo also ships a skill named "prototype" that would clobber the
    # local prototype skill (installed above); rename his copy, then re-install
    # the local skills to restore anything else his install overwrote.
    rename_installed_skill "prototype" "emil-prototype"
    try_or_warn_quiet "Re-installing local skills" \
        npx --yes skills add "$LOCAL_SKILLS_SOURCE" -g -y -a "claude-code" -a "opencode"

    # Stripe (payments, billing, invoicing, identity)
    echo -e "  Installing Stripe skills..."
    try_or_warn_quiet "Installing Stripe skills" npx --yes skills add "https://docs.stripe.com" -g -y -a "claude-code" -a "opencode"

    # Meta
    install_skill "https://github.com/anthropics/skills" "skill-creator"

    # Writing
    install_skill "https://github.com/obra/the-elements-of-style" "writing-clearly-and-concisely"

    # Document
    install_skill "https://github.com/anthropics/skills" "pdf"
    install_skill "https://github.com/anthropics/skills" "xlsx"
    install_skill "https://github.com/anthropics/skills" "docx"

    # Design
    install_skill "https://github.com/zarazhangrui/frontend-slides" "frontend-slides"
    install_skill "https://github.com/vercel-labs/agent-skills" "web-design-guidelines"
    # install_skill "https://github.com/anthropics/skills" "frontend-design" (I use design taste skills now)
    # install_skill "https://github.com/rknall/claude-skills" "SVG Logo Designer"
    install_skill "https://github.com/Leonxlnx/taste-skill" "design-taste-frontend"
    install_skill "https://github.com/Leonxlnx/taste-skill" "gpt-taste"
    # install_skill "https://github.com/Leonxlnx/taste-skill" "image-to-code"
    install_skill "https://github.com/Leonxlnx/taste-skill" "redesign-existing-projects"
    # install_skill "https://github.com/Leonxlnx/taste-skill" "high-end-visual-design"
    # install_skill "https://github.com/Leonxlnx/taste-skill" "stitch-design-taste"
    install_skill "https://github.com/nextlevelbuilder/ui-ux-pro-max-skill" "ui-ux-pro-max"

    # Marketing
    echo -e "Installing Corey Haynes marketing skills..."
    try_or_warn_quiet "Installing Corey Haynes marketing skills" npx --yes skills add "coreyhaines31/marketingskills" -g -y -a "claude-code" -a "opencode"

    install_skill "herdrdev/herdr" "herdr"
    install_skill "smarzban/herdr-file-viewer" "herdr-file-viewer"

    # Video (Remotion)
    echo -e "  Installing Remotion skills..."
    try_or_warn_quiet "Installing Remotion skills" npx --yes skills add "remotion-dev/skills" -g -y -a "claude-code" -a "opencode"

    echo -e "${GREEN}Skills installed${NC}"
}

# Check if marketplace is already added
has_marketplace() {
    local name="$1"
    claude plugin marketplace list 2>/dev/null | grep -q "$name"
}

# Check if plugin is already installed
has_plugin() {
    local name="$1"
    claude plugin list 2>/dev/null | grep -q "$name"
}

# Add marketplace if not already added
add_marketplace() {
    local name="$1"
    local url="$2"
    if has_marketplace "$name"; then
        echo -e "${GRAY}  $name already added${NC}"
    else
        try_or_warn "add $name" claude plugin marketplace add "$url"
        echo -e "${GREEN}  $name added${NC}"
    fi
}

# Install plugin if not already installed
install_plugin() {
    local name="$1"
    if has_plugin "$name"; then
        echo -e "${GRAY}  $name already installed${NC}"
    else
        try_or_warn "install $name" claude plugin install "$name"
        echo -e "${GREEN}  $name installed${NC}"
    fi
}

# Add marketplaces
add_marketplaces() {
    echo ""
    echo "Adding marketplaces..."
    add_marketplace "claude-plugins-official" "anthropics/claude-plugins-official"
    add_marketplace "openai-codex" "openai/codex-plugin-cc"
}

# Install plugins
install_plugins() {
    echo ""
    echo "Installing plugins..."

    # Claude plugins official (LSPs, context7, playwright)
    install_plugin "context7@claude-plugins-official"
    install_plugin "playwright@claude-plugins-official"
    install_plugin "gopls-lsp@claude-plugins-official"
    install_plugin "lua-lsp@claude-plugins-official"
    install_plugin "pyright-lsp@claude-plugins-official"
    install_plugin "rust-analyzer-lsp@claude-plugins-official"
    install_plugin "swift-lsp@claude-plugins-official"
    install_plugin "typescript-lsp@claude-plugins-official"

    # OpenAI Codex (code review and task delegation)
    install_plugin "codex@openai-codex"
}

main() {
    install_claude
    install_opencode
    if [[ "$RESET_MODE" == "true" ]]; then
        reset_skills
    fi
    install_skills
    add_marketplaces
    install_plugins

    echo ""
    echo -e "${GREEN}Done!${NC} Run 'claude plugin list' to verify plugins."
}

main
