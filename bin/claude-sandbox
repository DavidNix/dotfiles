#!/usr/bin/env bash

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: claude [--without-sandbox] [--] [CLAUDE_ARGS...]

Run Claude Code with filesystem writes sandboxed by default.
    --without-sandbox  Run Claude Code directly without the macOS sandbox
    --               Pass all remaining arguments to Claude Code
    -h, --help       Show this help message (use -- --help for Claude's help)
EOF
}

main() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage
        return 0
    fi
    local without_sandbox=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --without-sandbox) without_sandbox=true; shift ;;
            --) shift; break ;;
            *) break ;;
        esac
    done

    local claude_bin script_dir config_dir
    claude_bin=$(command -v claude 2>/dev/null || true)
    [[ -n "$claude_bin" ]] || { printf 'claude: claude is not on PATH\n' >&2; return 1; }
    claude_bin=$(realpath "$claude_bin")
    if [[ "$without_sandbox" == true ]]; then
        exec "$claude_bin" "$@"
    fi

    script_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
    # shellcheck disable=SC1091
    source "$script_dir/../script/agent-sandbox.sh"
    sandbox_init cc

    config_dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
    [[ "$config_dir" == /* ]] || sandbox_die "CLAUDE_CONFIG_DIR must be absolute: $config_dir"
    mkdir -p "$config_dir"
    sandbox_allow_dir "$config_dir"
    sandbox_allow_sidecars "$HOME/.claude.json"
    # Settings may be symlinked to dotfiles outside the config directory.
    local settings
    for settings in settings.json settings.local.json CLAUDE.md; do
        if [[ -L "$config_dir/$settings" ]]; then
            sandbox_allow_sidecars "$config_dir/$settings"
        fi
    done
    sandbox_run "$claude_bin" "$@"
}

main "$@"
