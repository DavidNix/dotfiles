{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "code-review": {
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "*.envrc": "deny",
          "*.envrc.*": "deny",
          "*.envrc.example": "allow",
          "*.vault-password": "deny",
        },
      },
    },
    "security-review": {
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "*.envrc": "deny",
          "*.envrc.*": "deny",
          "*.envrc.example": "allow",
          "*.vault-password": "deny",
        },
      },
    },
  },
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.envrc": "deny",
      "*.envrc.*": "deny",
      "*.envrc.example": "allow",
      "*.vault-password": "deny",
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": {
      "*": "allow",
      "{env:OC_SANDBOX_OPENCODE_DATA_DIR}/auth.json": "deny",
      "{env:OC_SANDBOX_OPENCODE_DATA_DIR}/mcp-auth.json": "deny",
      "{env:OC_SANDBOX_OPENCODE_DATA_DIR}/opencode*.db*": "deny",
      "{env:OC_SANDBOX_OPENCODE_DATA_DIR}/log": "deny",
      "{env:OC_SANDBOX_OPENCODE_DATA_DIR}/log/**": "deny",
      "{env:OC_SANDBOX_OPENCODE_DATA_DIR}/project": "deny",
      "{env:OC_SANDBOX_OPENCODE_DATA_DIR}/project/**": "deny",
      "{env:OC_SANDBOX_OPENCODE_DATA_DIR}/snapshot": "deny",
      "{env:OC_SANDBOX_OPENCODE_DATA_DIR}/snapshot/**": "deny",
      "{env:OC_SANDBOX_OPENCODE_DATA_DIR}/storage": "deny",
      "{env:OC_SANDBOX_OPENCODE_DATA_DIR}/storage/**": "deny",
    },
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "allow",
    "skill": "allow",
  },
}
