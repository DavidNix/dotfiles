{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
  ],
  "experimental": {
    // Secret-file policies come from opencode.jsonc; these protect OpenCode's private data.
    "policies": [
      { "action": "permission", "resource": "*:{env:OC_SANDBOX_OPENCODE_DATA_DIR}/auth.json", "effect": "deny" },
      { "action": "permission", "resource": "*:{env:OC_SANDBOX_OPENCODE_DATA_DIR}/mcp-auth.json", "effect": "deny" },
      { "action": "permission", "resource": "*:{env:OC_SANDBOX_OPENCODE_DATA_DIR}/opencode*.db*", "effect": "deny" },
      { "action": "permission", "resource": "*:{env:OC_SANDBOX_OPENCODE_DATA_DIR}/log", "effect": "deny" },
      { "action": "permission", "resource": "*:{env:OC_SANDBOX_OPENCODE_DATA_DIR}/log/*", "effect": "deny" },
      { "action": "permission", "resource": "*:{env:OC_SANDBOX_OPENCODE_DATA_DIR}/project", "effect": "deny" },
      { "action": "permission", "resource": "*:{env:OC_SANDBOX_OPENCODE_DATA_DIR}/project/*", "effect": "deny" },
      { "action": "permission", "resource": "*:{env:OC_SANDBOX_OPENCODE_DATA_DIR}/snapshot", "effect": "deny" },
      { "action": "permission", "resource": "*:{env:OC_SANDBOX_OPENCODE_DATA_DIR}/snapshot/*", "effect": "deny" },
      { "action": "permission", "resource": "*:{env:OC_SANDBOX_OPENCODE_DATA_DIR}/storage", "effect": "deny" },
      { "action": "permission", "resource": "*:{env:OC_SANDBOX_OPENCODE_DATA_DIR}/storage/*", "effect": "deny" },
    ],
  },
}
