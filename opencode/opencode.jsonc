{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "default_agent": "plan",
  "disabled_providers": ["opencode", "baseten"],
  "model": "openai/gpt-5.6-sol-fast",
  "small_model": "nixlab-small/qwen3.6-35b-a3b-nvfp4",
  "provider": {
    "nixlab-small": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nixlab Small",
      "options": {
        "baseURL": "http://ai2-inference:8000/v1",
        "apiKey": "local",
      },
      "models": {
        "qwen3.6-35b-a3b-nvfp4": {
          "name": "Qwen3.6-35B-A3B",
          "reasoning": true,
          "limit": {
            "context": 131072,
            "output": 32000,
          },
          "variants": {
            "none": {
              "chat_template_kwargs": {
                "enable_thinking": false,
              },
            },
            "thinking": {
              "chat_template_kwargs": {
                "enable_thinking": true,
              },
            },
            "low": { "disabled": true },
            "medium": { "disabled": true },
            "high": { "disabled": true },
          },
        },
      },
    },
    "nixlab-large": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nixlab Large",
      "options": {
        "baseURL": "http://ai1-inference:8000/v1",
        "apiKey": "local",
      },
      "models": {
        "deepseek-ai/DeepSeek-V4-Flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "reasoning": true,
          "limit": {
            "context": 262144,
            "output": 32000,
          },
          "variants": {
            "none": { "reasoningEffort": "none" },
            "low": { "reasoningEffort": "low" },
            "medium": { "disabled": true },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" },
          },
        },
      },
    },
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol-fast",
    },
    "explore": {
      "model": "nixlab-large/deepseek-ai/DeepSeek-V4-Flash-0731",
      "variant": "low",
      "permission": { "task": "deny" }, // deny subagents from spawning more subagents
    },
    "general": {
      "model": "nixlab-large/deepseek-ai/DeepSeek-V4-Flash-0731",
      "variant": "low",
      "permission": { "task": "deny" }, // deny subagents from spawning more subagents
    },
    "summary": {
      "model": "openai/gpt-5.6-luna",
    },
  },
  "share": "disabled",
  "autoupdate": "notify",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false,
    },
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.envrc": "deny",
      "*.envrc.*": "deny",
      "*.envrc.example": "allow",
      "*.vault-password": "deny",
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "codesearch": "allow",
    "bash": {
      // Default policy
      "*": "ask",

      // Shell validation
      "bash -n *": "allow",
      "shellcheck *": "allow",

      // Filesystem operations
      "cp *": "allow",
      "mkdir *": "allow",
      "mv *": "allow",

      // File inspection and navigation
      "basename *": "allow",
      "bat *": "allow",
      "cat *": "allow",
      "df *": "allow",
      "dirname *": "allow",
      "du *": "allow",
      "dust *": "allow",
      "file *": "allow",
      "find *": "allow",
      // find -delete remains blocked by the safe-commands plugin.
      "find *-exec*": "ask",
      "find *-ok*": "ask",
      "ls *": "allow",
      "lsd *": "allow",
      "lsbom *": "allow",
      "lsvfs *": "allow",
      "mdfind *": "allow",
      "mdls *": "allow",
      "pwd *": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "printf *": "allow",
      "stat *": "allow",
      "tree *": "allow",

      // Search and text processing
      "cmp *": "allow",
      "column *": "allow",
      "comm *": "allow",
      "cut *": "allow",
      "awk *": "allow",
      "echo *": "allow",
      "sed *": "allow",
      "diff *": "allow",
      "fold *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "hexdump *": "allow",
      "join *": "allow",
      "jq *": "allow",
      "jot *": "allow",
      "look *": "allow",
      "nl *": "allow",
      "numfmt *": "allow",
      "od *": "allow",
      "paste *": "allow",
      "pathchk *": "allow",
      "rev *": "allow",
      "rg *": "allow",
      "ripgrep *": "allow",
      "seq *": "allow",
      "sort *": "allow",
      "strings *": "allow",
      "sum *": "allow",
      "tac *": "allow",
      "tail *": "allow",
      "tr *": "allow",
      "uniq *": "allow",
      "wc *": "allow",

      // Checksums and archive inspection
      "b2sum *": "allow",
      "cksum *": "allow",
      "md5 *": "allow",
      "shasum *": "allow",
      "unzip -l *": "allow",
      "zipinfo *": "allow",

      // Compression filters that write only to stdout
      "bzcat *": "allow",
      "bzgrep *": "allow",
      "xzcat *": "allow",
      "xzgrep *": "allow",
      "zcat *": "allow",
      "zgrep *": "allow",

      // System and process inspection
      "arch": "allow",
      "cal *": "allow",
      "command -v *": "allow",
      "date *": "allow",
      "factor *": "allow",
      "getconf *": "allow",
      "groups *": "allow",
      "hostinfo *": "allow",
      "id *": "allow",
      "ioreg *": "allow",
      "iostat *": "allow",
      "locale *": "allow",
      "logname *": "allow",
      "lsof *": "allow",
      "netstat *": "allow",
      "nm *": "allow",
      "nproc *": "allow",
      "otool *": "allow",
      "pagesize *": "allow",
      "pgrep *": "allow",
      "procs *": "allow",
      "ps *": "allow",
      "size *": "allow",
      "sw_vers *": "allow",
      "system_profiler *": "allow",
      "tty *": "allow",
      "uname *": "allow",
      "uptime *": "allow",
      "users *": "allow",
      "vm_stat *": "allow",
      "w *": "allow",
      "whereis *": "allow",
      "which *": "allow",
      "who *": "allow",
      "whoami *": "allow",

      // Network and DNS inspection
      "dig *": "allow",
      "dog *": "allow",
      "host *": "allow",
      "nslookup *": "allow",
      "whois *": "allow",

      // Narrow macOS inspection operations
      "defaults read *": "allow",
      "diskutil info *": "allow",
      "diskutil list *": "allow",
      "pkgutil --files *": "allow",
      "pkgutil --pkg-info *": "allow",
      "pkgutil --pkgs *": "allow",
      "plutil -p *": "allow",
      "sips -g *": "allow",
      "sysctl -a": "allow",
      "sysctl -n *": "allow",

      // Documentation and code statistics
      "apropos *": "allow",
      "tokei *": "allow",
      "whatis *": "allow",

      // OpenCode diagnostics
      "opencode debug *": "allow",

      // New Relic queries
      "newrelic nrql *": "allow",

      // Image and diagram rendering
      "image-gen *": "allow",
      "merman-cli *": "allow",

      // Version control and hosting
      "git *": "allow", // plugin hook prevents dangerous commands
      "gh *": "allow",
      "glab *": "allow",

      // Go tooling
      "go *": "allow", // plugin hook prevents dangerous commands
      "gofmt *": "allow",
      "goimports *": "allow",
      "golangci-lint *": "allow",
      "gopls *": "allow",

      // Apple developer tooling inspection
      "xcrun --find *": "allow",
      "xcrun --show-sdk-path *": "allow",
      "xcrun --show-sdk-version *": "allow",

      // Rust tooling
      "cargo *": "allow", // plugin hook prevents dangerous commands
      "cargo-clippy *": "allow",
      "cargo-fmt *": "allow",
      "clippy-driver *": "allow",
      "rust-analyzer *": "allow",
      "rustc *": "allow",
      "rustdoc *": "allow",
      "rustfmt *": "allow",

      // Node.js tooling
      "npm astro *": "allow",
      "npm audit *": "allow",
      "npm ci *": "allow",
      "npm explain *": "allow",
      "npm list *": "allow",
      "npm view *": "allow",
      "npx astro *": "allow",
      "npx test *": "allow",

      // Homebrew inspection
      "brew deps *": "allow",
      "brew info *": "allow",
      "brew leaves *": "allow",
      "brew list *": "allow",
      "brew search *": "allow",
      "brew uses *": "allow",

      // uv and mise inspection
      "mise current *": "allow",
      "mise doctor *": "allow",
      "mise ls *": "allow",
      "mise where *": "allow",
      "mise which *": "allow",
      "uv pip check *": "allow",
      "uv pip freeze *": "allow",
      "uv pip list *": "allow",
      "uv pip show *": "allow",
      "uv python find *": "allow",
      "uv python list *": "allow",
      "uv tool list *": "allow",
      "uv tree *": "allow",

      // Trusted Make targets
      "make dev *": "allow",
      "make fmt *": "allow",
      "make lint *": "allow",
      "make test *": "allow",
      "make vet *": "allow",

      // Infrastructure validation
      "terraform fmt *": "allow",
      "terraform init *": "allow",
      "terraform plan *": "allow",
      "terraform state list *": "allow",
      "terraform validate *": "allow",
      "uv run ansible-lint *": "allow",

      // Container tooling
      "container *": "allow",
    },
    "skill": {
      "*": "allow",
      // "ai-tdd": "allow",
      // "brainstorm": "allow",
      // "docx": "allow",
      // "frontend-design": "allow",
      // "frontend-slides": "allow",
      // "opencode": "allow",
      // "pdf": "allow",
      // "prd": "allow",
      // "review-atodo": "allow",
      // "skill-creator": "allow",
      // "web-design-guidelines": "allow",
      // "writing-clearly-and-concisely": "allow",
      // "xlsx": "allow",
    },
    "task": {
      "*": "allow",
    },
    "external_directory": {
      "*": "ask",
      "~/.agents/**": "allow",
      "~/go/pkg/mod/**": "allow",
      "~/.cargo/registry/src/*": "allow",
    },
    "websearch": "ask",
    "question": "allow",
    "doom_loop": "ask",
    "context7*": "allow",
    "webfetch": "allow",
  },
}
