{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "openai/gpt-6.1-sol-fast",
  "agents": {
    "title": {
      "model": "openai/gpt-5.6-luna",
    },
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-6-astra-fast",
    },
    "build": {
      "model": "openai/gpt-6.1-sol-fast#low",
    },
    "explore": {
      "model": "openai/gpt-6.1-sol-fast#low",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }],
    },
    "general": {
      "model": "openai/gpt-6.1-sol-fast#low",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }],
    },
    "summary": {
      "model": "openai/gpt-5.6-luna",
    },
  },
  "share": "disabled",
  "update": "auto",
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "opencode", "effect": "deny" },
      { "action": "provider.use", "resource": "baseten", "effect": "deny" },
      // Policies apply after agent permissions, so a reviewer's read access cannot expose secrets.
      { "action": "permission", "resource": "read:*.env", "effect": "deny" },
      { "action": "permission", "resource": "read:*.env.*", "effect": "deny" },
      { "action": "permission", "resource": "read:*.env.example", "effect": "allow" },
      { "action": "permission", "resource": "read:*.envrc", "effect": "deny" },
      { "action": "permission", "resource": "read:*.envrc.*", "effect": "deny" },
      { "action": "permission", "resource": "read:*.envrc.example", "effect": "allow" },
      { "action": "permission", "resource": "read:*.vault-password", "effect": "deny" },
    ],
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": false,
      },
      "stripe": {
        "type": "remote",
        "url": "https://mcp.stripe.com",
        "disabled": true,
      },
      "chrome-devtools": {
        "type": "local",
        // Chrome runs outside oc's Seatbelt sandbox via bin/chrome-cdp; the MCP
        // attaches over CDP because launching Chrome inside the sandbox crashes.
        "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--browserUrl=http://127.0.0.1:9222"],
        "disabled": true,
      },
    },
  },
  "permissions": [
    // Secret files are denied by experimental.policies.
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    // Default policy
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Shell validation
    { "action": "shell", "resource": "bash -n *", "effect": "allow" },
    { "action": "shell", "resource": "shellcheck *", "effect": "allow" },

    // Filesystem operations
    { "action": "shell", "resource": "cp *", "effect": "allow" },
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "mv *", "effect": "allow" },

    // File inspection and navigation
    { "action": "shell", "resource": "basename *", "effect": "allow" },
    { "action": "shell", "resource": "bat *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "df *", "effect": "allow" },
    { "action": "shell", "resource": "dirname *", "effect": "allow" },
    { "action": "shell", "resource": "du *", "effect": "allow" },
    { "action": "shell", "resource": "dust *", "effect": "allow" },
    { "action": "shell", "resource": "file *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    // find -delete remains blocked by the safe-commands plugin.
    { "action": "shell", "resource": "find *-exec*", "effect": "ask" },
    { "action": "shell", "resource": "find *-ok*", "effect": "ask" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "lsd *", "effect": "allow" },
    { "action": "shell", "resource": "lsbom *", "effect": "allow" },
    { "action": "shell", "resource": "lsvfs *", "effect": "allow" },
    { "action": "shell", "resource": "mdfind *", "effect": "allow" },
    { "action": "shell", "resource": "mdls *", "effect": "allow" },
    { "action": "shell", "resource": "pwd *", "effect": "allow" },
    { "action": "shell", "resource": "readlink *", "effect": "allow" },
    { "action": "shell", "resource": "realpath *", "effect": "allow" },
    { "action": "shell", "resource": "printf *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "tree *", "effect": "allow" },

    // Search and text processing
    { "action": "shell", "resource": "cmp *", "effect": "allow" },
    { "action": "shell", "resource": "column *", "effect": "allow" },
    { "action": "shell", "resource": "comm *", "effect": "allow" },
    { "action": "shell", "resource": "cut *", "effect": "allow" },
    { "action": "shell", "resource": "awk *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "sed *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "fold *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "hexdump *", "effect": "allow" },
    { "action": "shell", "resource": "join *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "jot *", "effect": "allow" },
    { "action": "shell", "resource": "look *", "effect": "allow" },
    { "action": "shell", "resource": "nl *", "effect": "allow" },
    { "action": "shell", "resource": "numfmt *", "effect": "allow" },
    { "action": "shell", "resource": "od *", "effect": "allow" },
    { "action": "shell", "resource": "paste *", "effect": "allow" },
    { "action": "shell", "resource": "pathchk *", "effect": "allow" },
    { "action": "shell", "resource": "rev *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "ripgrep *", "effect": "allow" },
    { "action": "shell", "resource": "seq *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "strings *", "effect": "allow" },
    { "action": "shell", "resource": "sum *", "effect": "allow" },
    { "action": "shell", "resource": "tac *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "tr *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },

    // Checksums and archive inspection
    { "action": "shell", "resource": "b2sum *", "effect": "allow" },
    { "action": "shell", "resource": "cksum *", "effect": "allow" },
    { "action": "shell", "resource": "md5 *", "effect": "allow" },
    { "action": "shell", "resource": "shasum *", "effect": "allow" },
    { "action": "shell", "resource": "unzip -l *", "effect": "allow" },
    { "action": "shell", "resource": "zipinfo *", "effect": "allow" },

    // Compression filters that write only to stdout
    { "action": "shell", "resource": "bzcat *", "effect": "allow" },
    { "action": "shell", "resource": "bzgrep *", "effect": "allow" },
    { "action": "shell", "resource": "xzcat *", "effect": "allow" },
    { "action": "shell", "resource": "xzgrep *", "effect": "allow" },
    { "action": "shell", "resource": "zcat *", "effect": "allow" },
    { "action": "shell", "resource": "zgrep *", "effect": "allow" },

    // System and process inspection
    { "action": "shell", "resource": "arch", "effect": "allow" },
    { "action": "shell", "resource": "cal *", "effect": "allow" },
    { "action": "shell", "resource": "command -v *", "effect": "allow" },
    { "action": "shell", "resource": "date *", "effect": "allow" },
    { "action": "shell", "resource": "factor *", "effect": "allow" },
    { "action": "shell", "resource": "getconf *", "effect": "allow" },
    { "action": "shell", "resource": "groups *", "effect": "allow" },
    { "action": "shell", "resource": "hostinfo *", "effect": "allow" },
    { "action": "shell", "resource": "id *", "effect": "allow" },
    { "action": "shell", "resource": "ioreg *", "effect": "allow" },
    { "action": "shell", "resource": "iostat *", "effect": "allow" },
    { "action": "shell", "resource": "locale *", "effect": "allow" },
    { "action": "shell", "resource": "logname *", "effect": "allow" },
    { "action": "shell", "resource": "lsof *", "effect": "allow" },
    { "action": "shell", "resource": "netstat *", "effect": "allow" },
    { "action": "shell", "resource": "nm *", "effect": "allow" },
    { "action": "shell", "resource": "nproc *", "effect": "allow" },
    { "action": "shell", "resource": "otool *", "effect": "allow" },
    { "action": "shell", "resource": "pagesize *", "effect": "allow" },
    { "action": "shell", "resource": "pgrep *", "effect": "allow" },
    { "action": "shell", "resource": "procs *", "effect": "allow" },
    { "action": "shell", "resource": "ps *", "effect": "allow" },
    { "action": "shell", "resource": "size *", "effect": "allow" },
    { "action": "shell", "resource": "sw_vers *", "effect": "allow" },
    { "action": "shell", "resource": "system_profiler *", "effect": "allow" },
    { "action": "shell", "resource": "tty *", "effect": "allow" },
    { "action": "shell", "resource": "uname *", "effect": "allow" },
    { "action": "shell", "resource": "uptime *", "effect": "allow" },
    { "action": "shell", "resource": "users *", "effect": "allow" },
    { "action": "shell", "resource": "vm_stat *", "effect": "allow" },
    { "action": "shell", "resource": "w *", "effect": "allow" },
    { "action": "shell", "resource": "whereis *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "who *", "effect": "allow" },
    { "action": "shell", "resource": "whoami *", "effect": "allow" },

    // Network and DNS inspection
    { "action": "shell", "resource": "dig *", "effect": "allow" },
    { "action": "shell", "resource": "dog *", "effect": "allow" },
    { "action": "shell", "resource": "host *", "effect": "allow" },
    { "action": "shell", "resource": "nslookup *", "effect": "allow" },
    { "action": "shell", "resource": "whois *", "effect": "allow" },

    // Narrow macOS inspection operations
    { "action": "shell", "resource": "defaults read *", "effect": "allow" },
    { "action": "shell", "resource": "diskutil info *", "effect": "allow" },
    { "action": "shell", "resource": "diskutil list *", "effect": "allow" },
    { "action": "shell", "resource": "pkgutil --files *", "effect": "allow" },
    { "action": "shell", "resource": "pkgutil --pkg-info *", "effect": "allow" },
    { "action": "shell", "resource": "pkgutil --pkgs *", "effect": "allow" },
    { "action": "shell", "resource": "plutil -p *", "effect": "allow" },
    { "action": "shell", "resource": "sips -g *", "effect": "allow" },
    { "action": "shell", "resource": "sysctl -a", "effect": "allow" },
    { "action": "shell", "resource": "sysctl -n *", "effect": "allow" },

    // Documentation and code statistics
    { "action": "shell", "resource": "apropos *", "effect": "allow" },
    { "action": "shell", "resource": "tokei *", "effect": "allow" },
    { "action": "shell", "resource": "whatis *", "effect": "allow" },

    // OpenCode diagnostics
    { "action": "shell", "resource": "opencode debug *", "effect": "allow" },

    // New Relic queries
    { "action": "shell", "resource": "newrelic nrql *", "effect": "allow" },

    // Image and diagram rendering
    { "action": "shell", "resource": "image-gen *", "effect": "allow" },
    { "action": "shell", "resource": "merman-cli *", "effect": "allow" },

    // Version control and hosting
    { "action": "shell", "resource": "git *", "effect": "allow" }, // plugin hook prevents dangerous commands
    { "action": "shell", "resource": "gh *", "effect": "allow" },
    { "action": "shell", "resource": "glab *", "effect": "allow" },

    // Go tooling
    { "action": "shell", "resource": "go *", "effect": "allow" }, // plugin hook prevents dangerous commands
    { "action": "shell", "resource": "gofmt *", "effect": "allow" },
    { "action": "shell", "resource": "goimports *", "effect": "allow" },
    { "action": "shell", "resource": "golangci-lint *", "effect": "allow" },
    { "action": "shell", "resource": "gopls *", "effect": "allow" },

    // Apple developer tooling inspection
    { "action": "shell", "resource": "xcrun --find *", "effect": "allow" },
    { "action": "shell", "resource": "xcrun --show-sdk-path *", "effect": "allow" },
    { "action": "shell", "resource": "xcrun --show-sdk-version *", "effect": "allow" },

    // Rust tooling
    { "action": "shell", "resource": "cargo *", "effect": "allow" }, // plugin hook prevents dangerous commands
    { "action": "shell", "resource": "cargo-clippy *", "effect": "allow" },
    { "action": "shell", "resource": "cargo-fmt *", "effect": "allow" },
    { "action": "shell", "resource": "clippy-driver *", "effect": "allow" },
    { "action": "shell", "resource": "rust-analyzer *", "effect": "allow" },
    { "action": "shell", "resource": "rustc *", "effect": "allow" },
    { "action": "shell", "resource": "rustdoc *", "effect": "allow" },
    { "action": "shell", "resource": "rustfmt *", "effect": "allow" },

    // Node.js tooling
    { "action": "shell", "resource": "playwright-cli *", "effect": "allow" },
    { "action": "shell", "resource": "npm astro *", "effect": "allow" },
    { "action": "shell", "resource": "npm audit *", "effect": "allow" },
    { "action": "shell", "resource": "npm ci *", "effect": "allow" },
    { "action": "shell", "resource": "npm explain *", "effect": "allow" },
    { "action": "shell", "resource": "npm list *", "effect": "allow" },
    { "action": "shell", "resource": "npm view *", "effect": "allow" },
    { "action": "shell", "resource": "npx astro *", "effect": "allow" },
    { "action": "shell", "resource": "npx test *", "effect": "allow" },

    // Homebrew inspection
    { "action": "shell", "resource": "brew deps *", "effect": "allow" },
    { "action": "shell", "resource": "brew info *", "effect": "allow" },
    { "action": "shell", "resource": "brew leaves *", "effect": "allow" },
    { "action": "shell", "resource": "brew list *", "effect": "allow" },
    { "action": "shell", "resource": "brew search *", "effect": "allow" },
    { "action": "shell", "resource": "brew uses *", "effect": "allow" },

    // uv and mise inspection
    { "action": "shell", "resource": "mise current *", "effect": "allow" },
    { "action": "shell", "resource": "mise doctor *", "effect": "allow" },
    { "action": "shell", "resource": "mise ls *", "effect": "allow" },
    { "action": "shell", "resource": "mise where *", "effect": "allow" },
    { "action": "shell", "resource": "mise which *", "effect": "allow" },
    { "action": "shell", "resource": "uv pip check *", "effect": "allow" },
    { "action": "shell", "resource": "uv pip freeze *", "effect": "allow" },
    { "action": "shell", "resource": "uv pip list *", "effect": "allow" },
    { "action": "shell", "resource": "uv pip show *", "effect": "allow" },
    { "action": "shell", "resource": "uv python find *", "effect": "allow" },
    { "action": "shell", "resource": "uv python list *", "effect": "allow" },
    { "action": "shell", "resource": "uv tool list *", "effect": "allow" },
    { "action": "shell", "resource": "uv tree *", "effect": "allow" },

    // Trusted Make targets
    { "action": "shell", "resource": "make dev *", "effect": "allow" },
    { "action": "shell", "resource": "make fmt *", "effect": "allow" },
    { "action": "shell", "resource": "make lint *", "effect": "allow" },
    { "action": "shell", "resource": "make test *", "effect": "allow" },
    { "action": "shell", "resource": "make vet *", "effect": "allow" },

    // Infrastructure validation
    { "action": "shell", "resource": "terraform fmt *", "effect": "allow" },
    { "action": "shell", "resource": "terraform init *", "effect": "allow" },
    { "action": "shell", "resource": "terraform plan *", "effect": "allow" },
    { "action": "shell", "resource": "terraform state list *", "effect": "allow" },
    { "action": "shell", "resource": "terraform validate *", "effect": "allow" },
    { "action": "shell", "resource": "tofu fmt *", "effect": "allow" },
    { "action": "shell", "resource": "tofu init *", "effect": "allow" },
    { "action": "shell", "resource": "tofu plan *", "effect": "allow" },
    { "action": "shell", "resource": "tofu state list *", "effect": "allow" },
    { "action": "shell", "resource": "tofu validate *", "effect": "allow" },
    { "action": "shell", "resource": "uv run ansible-lint *", "effect": "allow" },

    // Container tooling
    { "action": "shell", "resource": "container *", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.agents/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/go/pkg/mod/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cargo/registry/src/*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "ask" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "context7*", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
  ],
}
