{
  "name": "subagents",
  "version": "0.5.0",
  "description": "Runs chosen subagent types on chosen models (Explore on Sonnet, general-purpose on Opus)",
  "author": {
    "name": "David Nix"
  },
  "userConfig": {
    "routes": {
      "type": "string",
      "title": "Routes",
      "description": "Comma-separated type=model pairs, e.g. Explore=claude-sonnet-5-5",
      "default": "Explore=claude-sonnet-5-5,general-purpose=claude-opus-5-5"
    }
  }
}
